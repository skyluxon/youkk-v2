# 복사해서 .env.local 로 만든 뒤 값을 채우세요. (.env.local 은 git에 올라가지 않습니다)

# 대화/후보/컨셉 생성용 LLM (OpenRouter)
OPENROUTER_API_KEY=
# 구조화 출력(JSON schema)을 지원하는 모델 ID. 바꾸고 싶으면 여기만 수정.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# 스톡 영상 탐침용 (검색 결과 수만 조회, 다운로드 없음)
PIXABAY_API_KEY=

# 이 건수 이상이면 해당 키워드를 스톡으로 충분하다고 판단 (Pixabay 결과 수는 500에서 잘림)
STOCK_ENOUGH_HITS=100

# 남용 방지
RATE_LIMIT_PER_10MIN=30
DAILY_LLM_LIMIT=300

# 1 이면 키 없이 데모 데이터로 화면 흐름만 확인
MOCK_LLM=0
